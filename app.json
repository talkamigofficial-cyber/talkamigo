{
  "expo": {
    "name": "TalkAmigo",
    "slug": "talkamigo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.talkamigo.app",
      "infoPlist": {}
    },
    "android": {
      "package": "com.talkamigo.app",
      "adaptiveIcon": {
        "backgroundColor": "#E0101F",
        "foregroundImage": "./assets/icon.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#C20A1A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TalkAmigo uses your photos so you can choose a profile picture.",
          "cameraPermission": "TalkAmigo uses the camera so you can take a profile photo."
        }
      ]
    ],
    "scheme": "talkamigo",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "dac9e6c3-3427-4b70-9acb-8456ee112960"
      }
    },
    "owner": "talkamigo2030",
    "updates": {
      "url": "https://u.expo.dev/dac9e6c3-3427-4b70-9acb-8456ee112960"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
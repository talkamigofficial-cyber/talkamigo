{
  "expo": {
    "name": "TalkAmigo",
    "slug": "talkamigo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.talkamigo.app"
    },
    "android": {
      "package": "com.talkamigo.app",
      "adaptiveIcon": {
        "backgroundColor": "#E0101F",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#C20A1A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TalkAmigo uses your photos so you can choose a profile picture.",
          "cameraPermission": "TalkAmigo uses the camera so you can take a profile photo."
        }
      ]
    ],
    "scheme": "talkamigo",
    "experiments": {
      "typedRoutes": false
    }
  }
}